<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="26.7.0" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\mysql.example.json" Link="mysql.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\mysql.local.json" Link="mysql.local.json" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" Condition="Exists('..\mysql.local.json')" />
  </ItemGroup>

</Project>
